.mypy_cache/

# macOS system files
.DS_Store

# Environment variables and secrets
.env
.env.*
*.pem
*.key
*.crt

# AWS credentials and local config
.aws/
credentials
config

# Logs
*.log
logs/

# Jupyter checkpoints
.ipynb_checkpoints/

# Editor and IDE files
.vscode/
.idea/

